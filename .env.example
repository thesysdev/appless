# Copy to .env.local. EXPO_PUBLIC_* values are embedded in the app bundle.

# OUI-1 served by vLLM. Use the GPU host's LAN IP or HTTPS URL on a real phone.
# Defaults: localhost on iOS simulator/web; 10.0.2.2 on Android emulator.
# EXPO_PUBLIC_MODEL_BASE_URL=http://192.168.1.100:8000/v1
EXPO_PUBLIC_GENOS_MODEL=OUI-1

# Optional authentication. Leave unset for a local server without an API key.
# To prompt for a device-stored key on first launch:
# EXPO_PUBLIC_MODEL_AUTH_REQUIRED=1
# Or supply a development key in the bundle (not a private deployment secret):
# EXPO_PUBLIC_MODEL_API_KEY=your-server-key

# Generation and single-GPU prefetch settings:
EXPO_PUBLIC_GENOS_MAX_TOKENS=4096
EXPO_PUBLIC_GENOS_PREFETCH_CONCURRENCY=1  # 0 disables speculative generation

# Optional tools:
# EXPO_PUBLIC_EXA_API_KEY=            # web_search, else the model invents data
# EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=    # real photos, else LoremFlickr

# Opt out of anonymous run analytics:
# EXPO_PUBLIC_POSTHOG_DISABLED=1
